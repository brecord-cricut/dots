[core]
  pager = delta

[init]
	defaultBranch = main

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[pull]
  rebase = true

[fetch]
  prune = true

[user]
  useConfigOnly = true

[include]
  path = ~/.local/state/git/config

# Per-repo hooks for everything under repos/, dispatched by repo name
[includeIf "gitdir:~/.local/share/repos/"]
  path = ~/.config/git/hooks.config
